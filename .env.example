# =============================================================================
# OT/ICS Security Lab — environment template
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env.
# To generate a random admin token: openssl rand -hex 32
# =============================================================================

# --- InfluxDB initial setup -----------------------------------------------
# These values are used the first time the InfluxDB container starts.
# After that, changing them in .env will NOT change the running InfluxDB —
# you would need to delete the influxdb_data volume to re-run setup.

# The username you log in to the InfluxDB web UI with.
INFLUXDB_INIT_USERNAME=otlabadmin

# The password for that username.
# At least 16 characters, mix of letters/numbers/symbols.
# Generate one with: openssl rand -base64 24
INFLUXDB_INIT_PASSWORD=CHANGE_ME_MIN_16_CHARS

# An "org" is InfluxDB's name for a top-level group that owns buckets.
# This lab uses one org for everything.
INFLUXDB_INIT_ORG=otlab

# A "bucket" is where the time-series data actually lives. Telegraf
# will write every PLC reading into this bucket.
INFLUXDB_INIT_BUCKET=plc_metrics

# How long to keep data before InfluxDB deletes it. 30d means 30 days.
# Lab scale, so 30 days is plenty.
INFLUXDB_INIT_RETENTION=30d

# A long random string Telegraf and Grafana use to authenticate to
# InfluxDB. Generate one with: openssl rand -hex 32
INFLUXDB_INIT_ADMIN_TOKEN=CHANGE_ME_GENERATE_LONG_RANDOM_TOKEN

# --- Grafana admin login --------------------------------------------------
# These values are read by Grafana on first start of the container.

# The admin username for the Grafana web UI (http://localhost:3000).
GRAFANA_ADMIN_USER=otlabadmin

# The admin password.
# At least 16 characters, mix of letters/numbers/symbols.
# Generate one with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_MIN_16_CHARS
